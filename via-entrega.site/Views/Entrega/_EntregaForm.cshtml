@model ViewModels.Pedidos.EntregaViewModel

@{
	ViewBag.Title = "Solicitação de Entrega";
	Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="UTF-8" />
	<title>Via Entrega - Solicitação</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="js\entregaform.js"></script>

	<style>
		body {
			background-color: #ff7300;
		}

		.form-container {
			background-color: #fff;
			padding: 2rem;
			border-radius: 10px;
			margin: 50px auto;
			max-width: 800px;
		}

		.btn-orange {
			background-color: #ff7300;
			color: white;
		}

			.btn-orange:hover {
				background-color: #e06200;
			}

		.product-card img {
			max-width: 100px;
			max-height: 100px;
		}

		.toggle-products {
			cursor: pointer;
			color: #ff7300;
		}

		input:focus, textarea:focus, select:focus {
			border-color: #ff7300 !important;
			box-shadow: 0 0 0 0.25rem rgba(255, 115, 0, 0.25) !important;
			outline: none !important;
		}
	</style>
</head>
<body>
	<script>
		window.onload = function () {
			const produtosJson = '@Html.Raw(Model.ProdutosJson ?? "[]")';

			try {
				productList = JSON.parse(produtosJson);
				renderProducts();
				updateProductCount();
			} catch (e) {
				console.error("Erro ao carregar produtos:", e);
				productList = [];
			}
		};
	</script>
	<div class="form-container shadow">
		<h4 class="text-center mb-4">Solicitação de Entrega</h4>

		<form asp-action="Criar" asp-controller="Entrega" method="post" enctype="multipart/form-data" id="deliveryForm">
			<div class="row">
				<div class="col-md-6 mb-3">
					<label asp-for="Endereco" class="form-label"></label>
					<input asp-for="Endereco" class="form-control" />
					<span asp-validation-for="Endereco" class="text-danger"></span>
				</div>
				<div class="col-md-6 mb-3">
					<label asp-for="Destinatario" class="form-label"></label>
					<input asp-for="Destinatario" class="form-control" />
					<span asp-validation-for="Destinatario" class="text-danger"></span>
				</div>
			</div>

			<div class="row">
				<div class="col-md-6 mb-3">
					<label asp-for="Telefone" class="form-label"></label>
					<input asp-for="Telefone" class="form-control" />
				</div>
				<div class="col-md-6 mb-3">
					<label asp-for="Documento" class="form-label"></label>
					<input asp-for="Documento" class="form-control" />
				</div>
			</div>

			<div class="mb-3">
				<label asp-for="Observacao" class="form-label"></label>
				<textarea asp-for="Observacao" class="form-control" rows="3"></textarea>
			</div>

			<!-- Produto -->
			<h5 class="mt-4">Adicionar Produto</h5>
			<div id="productForm">
				<div class="row g-2">
					<div class="col-12">
						<input type="text" class="form-control" placeholder="Descrição do produto" id="descricao" />
					</div>
				</div>

				<div class="row g-2 mt-2">
					<div class="col-md-4"><input type="number" class="form-control" placeholder="Altura (cm)" id="altura" /></div>
					<div class="col-md-4"><input type="number" class="form-control" placeholder="Largura (cm)" id="largura" /></div>
					<div class="col-md-4"><input type="number" class="form-control" placeholder="Comprimento" id="comprimento" /></div>
				</div>

				<div class="row g-2 mt-2">
					<div class="col-md-4"><input type="number" class="form-control" placeholder="Peso (kg)" id="peso" /></div>
					<div class="col-md-4"><input type="number" class="form-control" placeholder="Valor (R$)" id="valor" /></div>
					<div class="col-md-4"><input type="number" class="form-control" placeholder="Quantidade" id="quantidade" /></div>
				</div>

				<div class="row mt-2">
					<div class="col-12">
						<input type="file" class="form-control" id="imagem" />
					</div>
				</div>

				<button type="button" class="btn btn-orange mt-3 w-100" id="btnAddProduct">Adicionar Produto</button>
			</div>

			<input type="hidden" name="ProdutosJson" id="ProdutosJson" />

			<!-- Lista de Produtos -->
			<div class="mt-4">
				<span class="toggle-products" onclick="toggleProducts()">👁️ Ver/Ocultar Produtos Adicionados (<span id="productCount">0</span>)</span>
				<div id="productList" class="row mt-3 d-none"></div>
			</div>

			<button type="submit" class="btn btn-orange w-100 mt-4">Registrar Entrega</button>
		</form>
	</div>

</body>
</html>
