@model IEnumerable<ViewModels.Pedidos.EntregaResumoViewModel>
@{
	ViewBag.Title = "Lista de Entregas";
	Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="UTF-8">
	<title>Entregas</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light">
	<div class="container mt-5">
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h4>Entregas</h4>
			<button class="btn btn-success" onclick="openModal()">+ Nova Entrega</button>
		</div>

		<div class="mb-3">
			<input type="text" class="form-control" id="searchInput" placeholder="Buscar por destinatário ou endereço..." onkeyup="filterGrid()" />
		</div>

		<table class="table table-bordered table-striped">
			<thead class="table-dark">
				<tr>
					<th>ID</th>
					<th>Destinatário</th>
					<th>Endereço</th>
					<th>Telefone</th>
					<th>Ações</th>
				</tr>
			</thead>
			<tbody id="entregasTable">
				@foreach (var item in Model)
				{
					<tr>
						<td>@item.Id</td>
						<td>@item.Destinatario</td>
						<td>@item.Endereco</td>
						<td>@item.Telefone</td>
						<td>
							<button class="btn btn-sm btn-primary" onclick="editEntrega(@item.Id)">Editar</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Modal -->
	<div class="modal fade" id="entregaModal" tabindex="-1" aria-labelledby="entregaModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<div class="modal-header bg-primary text-white">
					<h5 class="modal-title" id="entregaModalLabel">Nova Entrega</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
				</div>
				<div class="modal-body" id="modalBodyContent">
					<!-- Formulário será carregado aqui via AJAX -->
					<div class="text-center">Carregando...</div>
				</div>
			</div>
		</div>
	</div>
	<script src="js/entregaLista.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
