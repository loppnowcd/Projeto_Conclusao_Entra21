@using via_entrega.entities.Enums
@model IEnumerable<ViewModels.PessoaFisica.MeusPedidosEntregaViewModel>

@functions {
    // mapeia o enum Status para classes visuais
    string BadgeClass(Status s) => s switch
    {
        Status.Devolvido => "badge badge-warning",
        Status.Entregue => "badge badge-info",
        Status.AguardandoColeta => "badge badge-success",
        Status.Cancelado => "badge badge-danger",
        _ => "badge badge-secondary"
    };

    string StatusLabel(Status s) => s.ToString(); // ajuste se quiser labels customizados
}

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <div class="icon">🚚</div>
        <div>
            <h5>Nenhum pedido encontrado</h5>
            <p>Quando houver pedidos de entrega, eles aparecerão aqui.</p>
        </div>
    </div>
}
else
{
    <ol class="timeline">
        @foreach (var item in Model)
        {
            <li class="timeline-item">
                <div class="dot"></div>
                <article class="cardy">
                    <header class="cardy-header">
                        <div class="title">
                            <strong>@(string.IsNullOrWhiteSpace(item.NomeCliente) ? "Cliente não informado" : item.NomeCliente)</strong>
                        </div>
                        <span class="@BadgeClass(item.Status)">@StatusLabel(item.Status)</span>
                    </header>

                    <div class="cardy-body">
                        <div class="rowline">
                            <span class="k">Coleta</span>
                            <span class="v">@item.DataColeta.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="rowline">
                            <span class="k">Entrega</span>
                            <span class="v">@(item.DataEntrega?.ToString("dd/MM/yyyy") ?? "-")</span>
                        </div>
                    </div>
                </article>
            </li>
        }
    </ol>
}

