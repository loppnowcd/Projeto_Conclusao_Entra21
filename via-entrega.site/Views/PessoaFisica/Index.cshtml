<div id="meus-pedidos-entrega"></div>

@section Scripts {
    <script>
        (function(){
            const url = '@Url.Action("ListarMeusPedidosEntrega", "PessoaFisica")';
            fetch(url, { credentials: 'include' })
                .then(r => r.text())
                .then(html => document.getElementById('meus-pedidos-entrega').innerHTML = html)
                .catch(() => document.getElementById('meus-pedidos-entrega').innerHTML =
                    '<div class="alert alert-warning">Não foi possível carregar seus pedidos agora.</div>');
        })();
    </script>
}