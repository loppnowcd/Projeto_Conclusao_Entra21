@{
    ViewData["Title"] = "Contatos";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />


</head>
<body>
    <div class="container py-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="m-0">Contatos</h2>
            <button type="button" class="btn btn-primary" id="btnNovo">Novo contato</button>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h5 class="card-title m-0">Meus contatos</h5>
                    <input type="search" class="form-control" placeholder="Buscar por celular/email..." id="busca" style="max-width:260px;">
                </div>

                <div id="listaContainer" class="table-responsive">
                    <!-- _Table será carregado aqui via AJAX -->
                    <div class="text-center text-muted py-5">Carregando...</div>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_FormModal")

    <!-- Bootstrap JS (bundle com Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const listaContainer = document.getElementById('listaContainer');
        const buscaInput = document.getElementById('busca');
        const btnNovo = document.getElementById('btnNovo');

        // Modal refs
        const modalEl = document.getElementById('contatoModal');
        const modal = new bootstrap.Modal(modalEl);
        const form = document.getElementById('formContato');
        const modalTitle = document.getElementById('modalTitle');
        const inputId = document.getElementById('id');
        const inputCel = document.getElementById('Celular');
        const inputTel = document.getElementById('Telefone');
        const inputEmail = document.getElementById('Email');

        // CSRF (AntiForgery)
        function getCsrf() {
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        async function carregarTabela() {
            const resp = await fetch('@Url.Action("List", "Contato")', { cache: 'no-store' });
            listaContainer.innerHTML = await resp.text();
        }

        function resetForm() {
            inputId.value = '';
            inputCel.value = '';
            inputTel.value = '';
            inputEmail.value = '';
        }

        function openCreateModal() {
            resetForm();
            modalTitle.textContent = 'Novo contato';
            modal.show();
        }

        async function openEditModal(id) {
            const url = '@Url.Action("GetById", "Contato")' + `?id=${id}`;
            const resp = await fetch(url, { cache: 'no-store' });
            if (!resp.ok) { alert('Contato não encontrado.'); return; }
            const data = await resp.json();
            inputId.value = data.id || '';
            inputCel.value = data.celular || data.Celular || '';
            inputTel.value = data.telefone || data.Telefone || '';
            inputEmail.value = data.email || data.Email || '';
            modalTitle.textContent = 'Editar contato';
            modal.show();
        }

        async function excluir(id) {
            if (!confirm('Excluir este contato?')) return;
            const resp = await fetch('@Url.Action("Delete", "Contato")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    '__RequestVerificationToken': getCsrf(),
                    'id': id
                })
            });
            if (resp.ok) {
                await carregarTabela();
                filtrarTabela();
            } else {
                const msg = await resp.text();
                alert(msg || 'Erro ao excluir.');
            }
        }

        // Delegação de eventos dos botões da tabela
        document.addEventListener('click', (ev) => {
            const btn = ev.target.closest('[data-action]');
            if (!btn) return;
            const action = btn.getAttribute('data-action');
            const id = btn.getAttribute('data-id');
            if (action === 'edit') openEditModal(id);
            if (action === 'delete') excluir(id);
        });

        // Criar (botão topo)
        btnNovo?.addEventListener('click', openCreateModal);

        // Submit do formulário (Create/Update)
        form.addEventListener('submit', async (ev) => {
            ev.preventDefault();
            const formData = new FormData(form);
            const resp = await fetch('@Url.Action("Save", "Contato")', { method: 'POST', body: formData });
            if (resp.ok) { modal.hide(); await carregarTabela(); filtrarTabela(); }
            else { const msg = await resp.text(); alert(msg || 'Erro ao salvar.'); }
        });

        // Busca simples no client
        function filtrarTabela() {
            const q = (buscaInput.value || '').toLowerCase();
            const rows = listaContainer.querySelectorAll('tbody tr');
            rows.forEach(tr => {
                const txt = (tr.dataset.cel + ' ' + tr.dataset.tel + ' ' + tr.dataset.email).toLowerCase();
                tr.style.display = txt.includes(q) ? '' : 'none';
            });
        }
        buscaInput?.addEventListener('input', filtrarTabela);

        // Inicialização
        (async () => { await carregarTabela(); })();
    </script>
</body>
</html>
