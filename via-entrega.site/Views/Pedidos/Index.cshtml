@model IEnumerable<ViewModels.Orders.OrderListItemVM>
@{
    ViewData["Title"] = "Meus Pedidos";
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="m-0">Meus Pedidos</h2>
        <a asp-action="Create" class="btn btn-primary">Solicitar Entrega</a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        @await Html.PartialAsync("_EmptyState", new {
        Title = "Você ainda não tem pedidos",
        Subtitle = "Crie sua primeira solicitação de entrega.",
        CtaText = "Solicitar Entrega",
        CtaAction = "Create",
        CtaController = "Pedidos"
        })
        }
        else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    @await Html.PartialAsync("_OrderCard", item)
                </div>
            }
        </div>
    }
</div>
