@model ViewModels.Cadastro.LoginViewModel;
@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Login - Via Entrega</title>
	<script src="https://js.hcaptcha.com/1/api.js" async defer></script>

	<!-- Bootstrap CSS -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">

	<!-- Font Awesome -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

	<!-- Google Fonts -->
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

	<link href="~/css/login.css" rel="stylesheet" />
</head>
<body>

	<div class="login-container">
		@if (!ViewData.ModelState.IsValid)
		{
			<div class="model-error-toast position-fixed top-0 end-0 p-3" style="z-index: 1055;">
				<div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
					@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
					{
						<div>@error.ErrorMessage</div>
					}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
				</div>
			</div>
		}

		<div class="logo-container">
			<i class="fa-solid fa-truck-fast"></i>
		</div>

		<h1 class="welcome-title">Olá!</h1>

		<form id="loginForm" asp-action="Login" asp-controller="Account">

			<div class="form-floating mb-3">
				<input type="email" class="form-control" name="Email" id="email" placeholder="Email" required>
				<label for="email">Email</label>
			</div>

			<div class="form-floating mb-3">
				<input type="password" class="form-control" name="Senha" id="senha" placeholder="Senha" required>
				<label for="senha">Senha</label>
			</div>
			<div class="h-captcha" data-sitekey="ecd62d9c-ce62-4cac-9c24-98700afacc56"></div>

			<div class="d-flex justify-content-between align-items-center mb-3">
				<div class="form-check">
					<input class="form-check-input" type="checkbox" id="lembrarSenha">
					<label class="form-check-label" for="lembrarSenha">Salvar senha</label>
				</div>
				<a href="#" class="forgot-password" id="forgotPassword">Esqueceu a senha?</a>
			</div>

			<button type="submit" class="btn btn-login mb-3">
				<i class="fas fa-sign-in-alt me-2"></i> Entrar
			</button>

			<div class="register-link">
				Não é cadastrado? <a href="#" id="cadastrarLink">Cadastre-se!</a>
			</div>
		</form>
	</div>

	<div class="toast-container" id="toastContainer"></div>

	<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

	<script>
		function showToast(message, type = 'info', title = '') {
			if (!title) {
				switch(type) {
					case 'success': title = 'Sucesso!'; break;
					case 'error': title = 'Erro!'; break;
					case 'warning': title = 'Atenção!'; break;
					case 'info': title = 'Informação'; break;
				}
			}

			const toastId = 'toast_' + Date.now();
			const toastHTML = `
				<div class="toast align-items-center text-bg-light border-0 ${type}" id="${toastId}" role="alert" aria-live="assertive" aria-atomic="true">
					<div class="d-flex">
						<div class="toast-body">${message}</div>
						<button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
					</div>
				</div>
			`;

			const container = document.getElementById('toastContainer');
			container.insertAdjacentHTML('beforeend', toastHTML);

			const toastElement = document.getElementById(toastId);
			const bsToast = new bootstrap.Toast(toastElement, { autohide: true, delay: 3000 });
			bsToast.show();

			toastElement.addEventListener('hidden.bs.toast', function() {
				this.remove();
			});
		}

			document.getElementById('loginForm').addEventListener('submit', function(e) {
			e.preventDefault(); // impede envio imediato

			const email = document.getElementById('email').value;
			const senha = document.getElementById('senha').value;

			if (!email || !senha) {
				showToast('Preencha todos os campos.', 'error');
				return;
			}

			const btn = this.querySelector('.btn-login');
			btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Entrando...';
			btn.disabled = true;

			this.submit();
		});

		document.getElementById('cadastrarLink').addEventListener('click', function(e) {
			e.preventDefault();
			showToast('Redirecionando para cadastro...', 'info');
		});

		document.getElementById('forgotPassword').addEventListener('click', function(e) {
			e.preventDefault();
			showToast('Redirecionando para recuperação de senha...', 'info');
		});
	</script>
</body>
</html>

