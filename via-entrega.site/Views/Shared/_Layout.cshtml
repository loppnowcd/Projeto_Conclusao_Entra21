@{
    var title = ViewData["Title"] as string ?? "Via Entrega";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title - Via Entrega</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Tema Via Entrega -->
    <link rel="stylesheet" href="~/css/site-viaentrega.css" asp-append-version="true" />
</head>
<body>

    <!-- Topbar (branding global) -->
    <header class="ve-topbar py-3">
        <div class="container text-center">
            <h1 class="h3 m-0">Via Entrega <span class="ms-1">🚚</span></h1>
            <small>Soluções ágeis e seguras para seu transporte</small>
        </div>

        @* Navbar opcional; remova se não usar *@
        <nav class="navbar navbar-expand-lg navbar-ve">
            <div class="container">
                <a class="navbar-brand fw-semibold text-dark" href="/">Início</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarVE">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarVE">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="#">Serviços</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Sobre</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Contato</a></li>
                    </ul>
                    <div class="d-flex gap-2">
                        @{
                            if (!Context.User.Identity.IsAuthenticated)
                            {
                                <a class="btn btn-outline-light" asp-controller="Account" asp-action="Index">Entrar</a>
                                <a class="btn btn-light" asp-controller="Cadastro" asp-action="Index">Cadastre-se</a>
                               
                            }
                            else
                            {
                                <button class="btn-usuario" aria-label="Sair">
                                    <a asp-controller="Account" asp-action="Logout">
                                        <i style="color: white;" class="fa-solid fa-arrow-alt-circle-right">
                                        </i> Sair
                                    </a>
                                </button>
                            }
                        }
                    </divclass>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3">
        <div class="container small text-muted">
            © @DateTime.Now.Year Via Entrega — Todos os direitos reservados
        </div>
    </footer>

    <!-- Bootstrap bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
