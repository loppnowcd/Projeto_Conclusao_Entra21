@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@{
    var autenticado = User?.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Via Entrega</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/_Layout.css">

</head>
<body>
    <!-- Header Principal -->
    <header class="main-header">
        <div class="container">
            <h1>Via Entrega <i class="fa-solid fa-truck-fast truck-icon"></i></h1>
            <p>Soluções ágeis e seguras para seu transporte</p>
        </div>
    </header>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container">
            <a class="navbar-brand-custom" asp-controller="Home" asp-action="Index">Via Entrega</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span style="color: white; font-size: 1.2rem;">☰</span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (!Context.User.Identity.IsAuthenticated)
                    {
                        <!-- MENU PÚBLICO (usuário NÃO logado) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Servico">
                                <i class="fa-solid fa-cogs me-1"></i> Serviços
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Sobre">
                                <i class="fa-solid fa-info-circle me-1"></i> Sobre
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contato" asp-action="Index">
                                <i class="fa-solid fa-envelope me-1"></i> Contato
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- MENU PRIVADO (usuário LOGADO) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contatos" asp-action="Index">
                                <i class="fa-solid fa-address-book me-1"></i> Contatos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Endereco" asp-action="Index">
                                <i class="fa-solid fa-map-marker-alt me-1"></i> Endereços
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cadastro" asp-action="Index">
                                <i class="fa-solid fa-user-plus me-1"></i> Cadastro
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Entrega" asp-action="Index">
                                <i class="fa-solid fa-shipping-fast me-1"></i> Entregas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Veiculo" asp-action="Index">
                                <i class="fa-solid fa-truck me-1"></i> Veículos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PedidoEntrega" asp-action="MeusPedidosEntrega">
                                <i class="fa-solid fa-list-alt me-1"></i> Meus Pedidos
                            </a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center">
                    @if (autenticado)
                    {
                        <span class="welcome-message">
                            <i class="fa-solid fa-user me-1"></i> Olá, @User.Identity?.Name
                        </span>
                        <a asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <i class="fa-solid fa-sign-out-alt me-1"></i> Sair
                        </a>
                    }
                    else
                    {
                        <a class="btn-user" asp-controller="Account" asp-action="Login">
                            <i class="fa-solid fa-sign-in-alt me-1"></i> Entrar
                        </a>
                        <a class="btn-user" asp-controller="Account" asp-action="Register">
                            <i class="fa-solid fa-user-plus me-1"></i> Cadastrar
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <p>&copy; 2025 Via Entrega - Todos os direitos reservados</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>