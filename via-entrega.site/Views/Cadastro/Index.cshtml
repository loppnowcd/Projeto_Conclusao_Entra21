@model ViewModels.Cadastro.CadastroViewModel
@{
	ViewData["Title"] = "Cadastro";
	Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<title>Cadastro | Via Entrega</title>

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

	<style>
		body {
			background-color: #f8f9fa;
		}

		.btn-orange {
			background-color: #ff7300;
			color: #fff;
		}

			.btn-orange:hover {
				background-color: #e26100;
			}
	</style>
</head>
<body>

	<div class="container py-5">
		<form asp-action="Registrar" method="post" asp-controller="Cadastro">
			<div class="text-center pb-4" style="color:#ff7300;">
				<h1>Via Entrega <i class="fa-solid fa-truck-fast"></i></h1>
				<p>Soluções ágeis e seguras para seu transporte</p>
			</div>

			<div class="row mb-3">
				<div class="col-md-6">
					<label asp-for="TipoPessoa" class="form-label">Tipo de Pessoa</label>
					<select asp-for="TipoPessoa" class="form-select" onchange="mudarTipoPessoa()">
						<option value="1">Pessoa Física</option>
						<option value="2">Pessoa Jurídica</option>
					</select>
				</div>
				<div class="col-md-6">
					<label asp-for="Nome" class="form-label">Nome Completo / Razão Social</label>
					<input asp-for="Nome" class="form-control" />
				</div>
			</div>

			<!-- Pessoa Física -->
			<div id="pessoaFisicaFields">
				<div class="row mb-3">
					<div class="col-md-6">
						<label asp-for="CPF" class="form-label">CPF</label>
						<input asp-for="CPF" class="form-control cpf" />
					</div>
					<div class="col-md-6">
						<label asp-for="NomeMae" class="form-label">Nome da Mãe</label>
						<input asp-for="NomeMae" class="form-control" />
					</div>
				</div>
				<div class="row mb-3">
					<div class="col-md-6">
						<label asp-for="Sexo" class="form-label">Sexo</label>
						<select asp-for="Sexo" class="form-select">
							<option value="1">Masculino</option>
							<option value="2">Feminino</option>
							<option value="3">Outro</option>
						</select>
					</div>
					<div class="col-md-6">
						<label asp-for="EstadoCivil" class="form-label">Estado Civil</label>
						<select asp-for="EstadoCivil" class="form-select">
							<option value="0">Solteiro</option>
							<option value="1">União Estável</option>
							<option value="2">Casado</option>
							<option value="3">Divorciado</option>
							<option value="4">Viúvo</option>
						</select>
					</div>
				</div>
				<div class="mb-3">
					<label asp-for="DataNascimento" class="form-label">Data de Nascimento</label>
					<input asp-for="DataNascimento" type="date" class="form-control" />
				</div>
			</div>

			<!-- Pessoa Jurídica -->
			<div id="pessoaJuridicaFields" style="display: none;">
				<div class="row mb-3">
					<div class="col-md-6">
						<label asp-for="CNPJ" class="form-label">CNPJ</label>
						<input asp-for="CNPJ" class="form-control cnpj" />
					</div>
					<div class="col-md-6">
						<label asp-for="NomeFantasia" class="form-label">Nome Fantasia</label>
						<input asp-for="NomeFantasia" class="form-control" />
					</div>
				</div>
			</div>

			<!-- Acesso -->
			<div class="row mb-3">
				<div class="col-md-6">
					<label asp-for="Email" class="form-label">Email</label>
					<input asp-for="Email" class="form-control" />
				</div>
				<div class="col-md-6">
					<label asp-for="Senha" class="form-label">Senha</label>
					<input asp-for="Senha" type="password" class="form-control" />
				</div>
			</div>
			<div class="mb-4">
				<label asp-for="ConfirmarSenha" class="form-label">Confirmar Senha</label>
				<input asp-for="ConfirmarSenha" type="password" class="form-control" />
			</div>

			<!-- ENDEREÇOS -->
			<h5 class="mb-3">Endereços</h5>
			<div id="enderecosContainer">
				@for (int i = 0; i < Model.Enderecos.Count; i++)
				{
					<div class="border p-3 mb-3 endereco-item rounded">
						<div class="row">
							<div class="col-md-6 mb-2">
								<input name="Enderecos[@i].Rua" value="@Model.Enderecos[i].Rua" class="form-control" placeholder="Rua" />
							</div>
							<div class="col-md-2 mb-2">
								<input name="Enderecos[@i].Numero" value="@Model.Enderecos[i].Numero" class="form-control" placeholder="Número" />
							</div>
							<div class="col-md-4 mb-2">
								<input name="Enderecos[@i].Bairro" value="@Model.Enderecos[i].Bairro" class="form-control" placeholder="Bairro" />
							</div>
							<div class="col-md-6 mb-2">
								<input name="Enderecos[@i].Cidade" value="@Model.Enderecos[i].Cidade" class="form-control" placeholder="Cidade" />
							</div>
							<div class="col-md-3 mb-2">
								<input name="Enderecos[@i].Estado" value="@Model.Enderecos[i].Estado" class="form-control" placeholder="UF" maxlength="2" />
							</div>
							<div class="col-md-3 mb-2">
								<input name="Enderecos[@i].CEP" value="@Model.Enderecos[i].CEP" class="form-control cep" placeholder="CEP" />
							</div>
						</div>
						<button type="button" class="btn btn-danger btn-sm removerEndereco mt-2">
							<i class="fas fa-trash"></i> Remover
						</button>
					</div>
				}
			</div>

			<button type="button" class="btn btn-outline-primary btn-sm mb-4" id="addEndereco">
				<i class="fas fa-plus"></i> Adicionar Endereço
			</button>

			<!-- CONTATOS -->
			<h5 class="mt-4">Contatos</h5>
			<div id="contatosContainer">
				@for (int i = 0; i < Model.Contatos.Count; i++)
				{
					<div class="border p-3 mb-3 contato-item rounded">
						<div class="row">
							<div class="col-md-4 mb-2">
								<input name="Contatos[@i].Celular" value="@Model.Contatos[i].Celular" class="form-control celular" placeholder="Celular" />
							</div>
							<div class="col-md-4 mb-2">
								<input name="Contatos[@i].Telefone" value="@Model.Contatos[i].Telefone" class="form-control telefone" placeholder="Telefone (opcional)" />
							</div>
							<div class="col-md-4 mb-2">
								<input name="Contatos[@i].Email" value="@Model.Contatos[i].Email" class="form-control" placeholder="Email" />
							</div>
						</div>
						<button type="button" class="btn btn-danger btn-sm removerContato mt-2">
							<i class="fas fa-trash"></i> Remover
						</button>
					</div>
				}
			</div>

			<button type="button" class="btn btn-outline-primary btn-sm mb-4" id="addContato">
				<i class="fas fa-plus"></i> Adicionar Contato
			</button>

			<!-- SUBMIT -->
			<div class="text-center">
				<button type="submit" class="btn btn-orange btn-lg">
					<i class="fas fa-paper-plane me-2"></i> Cadastrar
				</button>
			</div>
		</form>
	</div>

	<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	@if (TempData["Sucesso"] != null)
	{
		<script>
			Swal.fire({
				icon: 'success',
				title: 'Sucesso!',
				text: '@Html.Raw(TempData["Sucesso"])'
			});
		</script>
	}
	@if (TempData["Erro"] != null)
	{
		<script>
			Swal.fire({
				icon: 'error',
				title: 'Erro!',
				text: '@Html.Raw(TempData["Erro"])'
			});
		</script>
	}

	<script>

			function mudarTipoPessoa(){
					let tipoPesoa = document.getElementsByName("TipoPessoa")[0].value

				if(tipoPesoa === '1')
				{
					$('#pessoaFisicaFields').show();
					$('#pessoaJuridicaFields').hide();
				}
				else{
					$('#pessoaJuridicaFields').show();
					$('#pessoaFisicaFields').hide();
				}
			}


		$(document).ready(function () {

			let enderecoIndex = @Model.Enderecos?.Count ?? 0;

			$('#addEndereco').click(function () {
				let html = `
				<div class="border p-3 mb-3 endereco-item rounded">
					<div class="row">
						<div class="col-md-6 mb-2">
							<input name="Enderecos[${enderecoIndex}].Rua" placeholder="Rua" class="form-control" />
						</div>
						<div class="col-md-2 mb-2">
								<input name="Enderecos[${enderecoIndex}].Numero" placeholder="Número" class="form-control" />
						</div>
						<div class="col-md-4 mb-2">
								<input name="Enderecos[${enderecoIndex}].Bairro" placeholder="Bairro" class="form-control" />
						</div>
						<div class="col-md-6 mb-2">
								<input name="Enderecos[${enderecoIndex}].Cidade" placeholder="Cidade" class="form-control" />
						</div>
						<div class="col-md-3 mb-2">
								<input name="Enderecos[${enderecoIndex}].Estado" placeholder="UF" maxlength="2" class="form-control" />
						</div>
						<div class="col-md-3 mb-2">
								<input name="Enderecos[${enderecoIndex}].CEP" placeholder="CEP" class="form-control cep" />
						</div>
					</div>
					<button type="button" class="btn btn-danger btn-sm removerEndereco mt-2">
						<i class="fas fa-trash"></i> Remover
					</button>
				</div>
				`;
				$('#enderecosContainer').append(html);
				enderecoIndex++;
				$('.cep').mask('00000-000');
			});

					let contatoIndex = @Model.Contatos?.Count ?? 0;

					$('#addContato').click(function () {
			let html = `
				<div class="border p-3 mb-3 contato-item rounded">
					<div class="row">
						<div class="col-md-4 mb-2">
							<input name="Contatos[${contatoIndex}].Celular" placeholder="Celular" class="form-control celular" />
						</div>
						<div class="col-md-4 mb-2">
							<input name="Contatos[${contatoIndex}].Telefone" placeholder="Telefone (opcional)" class="form-control telefone" />
						</div>
						<div class="col-md-4 mb-2">
							<input name="Contatos[${contatoIndex}].Email" placeholder="Email" class="form-control" />
						</div>
					</div>
					<button type="button" class="btn btn-danger btn-sm removerContato mt-2">
						<i class="fas fa-trash"></i> Remover
					</button>
				</div>
			`;
			$('#contatosContainer').append(html);
			contatoIndex++;

			$('.celular').mask('(00) 00000-0000');
			$('.telefone').mask('(00) 0000-0000');
		});

				$(document).on('click', '.removerEndereco', function () {
					$(this).closest('.endereco-item').remove();
				});
						$(document).on('click', '.removerContato', function () {
			$(this).closest('.contato-item').remove();
		});
				$('.cep').mask('00000-000');
			})
	</script>
</body>
</html>
